# Telegram — get a token from @BotFather
TELEGRAM_BOT_TOKEN=

# LLM selection. The active provider's API key (below) must be set.
LLM_PROVIDER=huggingface
# Optional fallback used only on a retryable failure of the active provider:
# LLM_FALLBACK_PROVIDER=anthropic

# HuggingFace — https://huggingface.co/settings/tokens (active provider)
HUGGINGFACE_API_KEY=
# Must be a model served by HF Inference Providers for your token.
# Qwen2.5-7B-Instruct works on the free tier; Llama/Mistral are often gated (400).
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# Anthropic — https://console.anthropic.com/ (optional; only if selected above)
ANTHROPIC_API_KEY=

# Datastores (match docker-compose.yml)
DATABASE_URL=postgresql://ayla:ayla@localhost:5432/ayla?schema=public
REDIS_URL=redis://localhost:6379
